<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__NODE_BIN__:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.giuswhite.herdr-web</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE_BIN__/node</string>
		<string>__REPO__/server.mjs</string>
		<string>--host</string>
		<string>0.0.0.0</string>
		<string>--token</string>
		<string>__TOKEN__</string>
		<string>--tls-cert</string>
		<string>__HOME__/.config/herdr-web/tls/cert.pem</string>
		<string>--tls-key</string>
		<string>__HOME__/.config/herdr-web/tls/key.pem</string>
		<string>--notify</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/herdr-web.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/herdr-web.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
</dict>
</plist>
